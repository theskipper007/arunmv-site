---
import SubscribeForm from "./SubscribeForm.astro";

/** Site-wide subscribe dialog, opened by any element with [data-open-subscribe]. */
---

<dialog id="subscribe-dialog" class="nl-dialog" aria-labelledby="subscribe-dialog-title">
  <button type="button" class="nl-close" data-close-subscribe aria-label="Close">×</button>
  <p class="font-mono text-xs uppercase tracking-widest text-faint">Newsletter</p>
  <h2 id="subscribe-dialog-title" class="mt-1.5 font-serif text-2xl font-semibold text-ink">
    Get new posts by email
  </h2>
  <p class="mt-2 text-sm text-muted">One email per new post. Confirm once, unsubscribe any time.</p>
  <div class="mt-5">
    <SubscribeForm compact />
  </div>
</dialog>

<style>
  .nl-dialog {
    width: min(30rem, calc(100vw - 2rem));
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.22);
  }
  .nl-dialog::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(2px);
  }
  .nl-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--color-faint);
    font-size: 1.25rem;
    cursor: pointer;
  }
  .nl-close:hover {
    color: var(--color-ink);
  }
</style>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const dialog = document.querySelector<HTMLDialogElement>("#subscribe-dialog");
    if (!dialog) return;
    if (target.closest("[data-open-subscribe]")) {
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>("input[type=email]")?.focus();
    } else if (target.closest("[data-close-subscribe]") || target === dialog) {
      dialog.close();
    }
  });
</script>
