---
import Diagram from "../mdx/Diagram.astro";
---

<Diagram
  caption="The loop that makes a bundle worth maintaining: a change nudges its concept, the concept stays current, and both a human reviewer and an agent hit the guardrail before code moves — not after an incident finds it."
>
  <svg viewBox="0 0 760 230" role="img" aria-label="Lifecycle: a pull request touching packages/logic-engine triggers a CI nudge if knowledge/packages/logic-engine.md was not also touched. The concept file is read by a human reviewer via the PR diff and by an agent via CLAUDE.md or an MCP server. Both consult the change-risk table before the change ships, closing the loop back to the next pull request.">
    <defs>
      <marker id="lc-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--color-faint)"></path>
      </marker>
    </defs>

    <rect x="20" y="80" width="130" height="56" rx="9" fill="var(--color-paper)" stroke="var(--color-border)"></rect>
    <text x="85" y="103" text-anchor="middle" font-family="var(--font-sans)" font-size="11" font-weight="600" fill="var(--color-ink)">Pull request</text>
    <text x="85" y="119" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--color-faint)">touches packages/*</text>

    <rect x="188" y="80" width="150" height="56" rx="9" fill="color-mix(in oklab, #C9821B 8%, var(--color-surface))" stroke="#C9821B"></rect>
    <text x="263" y="101" text-anchor="middle" font-family="var(--font-sans)" font-size="11" font-weight="600" fill="var(--color-ink)">CI nudge</text>
    <text x="263" y="117" text-anchor="middle" font-family="var(--font-mono)" font-size="8.2" fill="var(--color-faint)">concept untouched?</text>
    <text x="263" y="130" text-anchor="middle" font-family="var(--font-mono)" font-size="8.2" fill="#C9821B">warns, doesn't block</text>

    <rect x="378" y="30" width="150" height="56" rx="9" fill="color-mix(in oklab, var(--color-accent) 9%, var(--color-surface))" stroke="var(--color-accent)"></rect>
    <text x="453" y="52" text-anchor="middle" font-family="var(--font-sans)" font-size="11" font-weight="600" fill="var(--color-ink)">Concept file</text>
    <text x="453" y="68" text-anchor="middle" font-family="var(--font-mono)" font-size="8.2" fill="var(--color-faint)">knowledge/packages/*.md</text>
    <text x="453" y="80" text-anchor="middle" font-family="var(--font-mono)" font-size="8.2" fill="var(--color-faint)">staleness date, change-risk table</text>

    <rect x="576" y="8" width="164" height="50" rx="9" fill="var(--color-paper)" stroke="var(--color-border)"></rect>
    <text x="658" y="28" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" font-weight="600" fill="var(--color-ink)">Human reviewer</text>
    <text x="658" y="43" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-faint)">reads it in the PR diff</text>

    <rect x="576" y="86" width="164" height="56" rx="9" fill="color-mix(in oklab, #2E8B57 8%, var(--color-surface))" stroke="#2E8B57"></rect>
    <text x="658" y="107" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" font-weight="600" fill="var(--color-ink)">Coding agent</text>
    <text x="658" y="122" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-faint)">CLAUDE.md pointer,</text>
    <text x="658" y="134" text-anchor="middle" font-family="var(--font-mono)" font-size="8" fill="var(--color-faint)">or MCP graph traversal</text>

    <rect x="378" y="168" width="300" height="46" rx="9" fill="color-mix(in oklab, #2E8B57 7%, var(--color-surface))" stroke="#2E8B57" stroke-dasharray="5 4"></rect>
    <text x="528" y="187" text-anchor="middle" font-family="var(--font-sans)" font-size="10.5" font-weight="700" fill="var(--color-ink)">"Don't delete — read path only"</text>
    <text x="528" y="202" text-anchor="middle" font-family="var(--font-mono)" font-size="8.2" fill="#2E8B57">decided before merge, not after a customer report</text>

    <line x1="150" y1="108" x2="186" y2="108" stroke="var(--color-faint)" stroke-width="1.4" marker-end="url(#lc-arrow)"></line>
    <line x1="338" y1="94" x2="376" y2="66" stroke="var(--color-faint)" stroke-width="1.4" marker-end="url(#lc-arrow)"></line>
    <line x1="528" y1="52" x2="574" y2="38" stroke="var(--color-faint)" stroke-width="1.4" marker-end="url(#lc-arrow)"></line>
    <line x1="528" y1="70" x2="574" y2="104" stroke="var(--color-faint)" stroke-width="1.4" marker-end="url(#lc-arrow)"></line>
    <line x1="658" y1="58" x2="600" y2="168" stroke="var(--color-faint)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#lc-arrow)"></line>
    <line x1="658" y1="142" x2="600" y2="168" stroke="var(--color-faint)" stroke-width="1.2" stroke-dasharray="3 3" marker-end="url(#lc-arrow)"></line>
  </svg>
</Diagram>
