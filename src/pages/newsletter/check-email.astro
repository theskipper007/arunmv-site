---
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout title="Check your email" description="Confirm your newsletter subscription." prose>
  <p class="font-mono text-xs uppercase tracking-widest text-faint">Newsletter</p>
  <h1 class="mt-3 font-serif text-4xl font-semibold tracking-tight text-ink">Check your email</h1>
  <p class="mt-4 text-lg text-muted">
    I've sent you a confirmation link. Click it within 48 hours to finish subscribing. If it isn't
    there in a few minutes, check your spam folder.
  </p>
  <p class="mt-8"><a href="/blog">Back to the writing →</a></p>
</PageLayout>
