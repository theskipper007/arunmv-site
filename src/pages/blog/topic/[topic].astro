---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CategoryNav from "../../../components/content/CategoryNav.astro";
import PostCard from "../../../components/content/PostCard.astro";
import {
  getPublishedPosts,
  postsByTopic,
  topicLabel,
  TOPICS,
  TOPIC_ORDER,
  type Topic,
} from "../../../lib/collections";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return TOPIC_ORDER.map((topic) => ({
    params: { topic },
    props: { posts: postsByTopic(posts, topic), topic },
  }));
};

interface Props {
  posts: Awaited<ReturnType<typeof getPublishedPosts>>;
  topic: Topic;
}
const { posts, topic } = Astro.props;
const label = topicLabel(topic);
---

<BaseLayout title={`${label} — Writing`} description={`Posts on ${label}.`}>
  <div class="mx-auto px-6 py-16" style="max-width: var(--content-max);">
    <header class="reveal">
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">{label}</h1>
      <p class="mt-3 font-mono text-sm text-faint">{posts.length} post{posts.length === 1 ? "" : "s"}</p>
    </header>

    <div class="mt-10">
      <CategoryNav active={TOPICS[topic].category} />
    </div>

    <div
      class="mt-6 grid gap-5"
      style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));"
    >
      {posts.map((post) => <PostCard post={post} />)}
      {posts.length === 0 && <p class="py-16 text-faint">Nothing here yet.</p>}
    </div>
  </div>
</BaseLayout>
