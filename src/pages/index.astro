---
import { ArrowRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedHero from "../components/content/FeaturedHero.astro";
import PostListItem from "../components/content/PostListItem.astro";
import TrustStrip from "../components/content/TrustStrip.astro";
import AboutPreview from "../components/content/AboutPreview.astro";
import BuildInProgress from "../components/content/BuildInProgress.astro";
import GithubIcon from "../components/ui/icons/GithubIcon.astro";
import { SITE } from "../lib/seo";
import TypeTag from "../components/content/TypeTag.astro";
import NewsletterBand from "../components/newsletter/NewsletterBand.astro";
import { Mail } from "@lucide/astro";
import { getPublishedPosts, formatDate, readingMinutes } from "../lib/collections";

const posts = await getPublishedPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const recent = posts.filter((p) => p.id !== featured?.id).slice(0, 4);
// Experiment-like posts get their own row, led by the headline result.
const LAB_TYPES = ["experiment", "benchmark", "ablation", "reproduction", "trendtest"];
const lab = posts.filter((p) => LAB_TYPES.includes(p.data.type)).slice(0, 3);
---

<BaseLayout>
  {/* ── Hero: a full-bleed typographic statement ─────────────────────── */}
  <section class="hero-band">
    <div
      class="reveal mx-auto flex flex-col justify-center px-6 pt-16 pb-12 sm:pt-24 sm:pb-16"
      style="max-width: var(--content-max); min-height: 70vh;"
    >
      <p
        class="mb-4 flex items-center gap-2 font-sans font-semibold text-ink"
        style="font-size: clamp(1.5rem, 4vw, 2.5rem); line-height: 1.1;"
        aria-label="Hi, I'm Arun"
      >
        <span data-greet>Hi, I'm Arun</span>
        <span class="wave" aria-hidden="true">👋</span>
      </p>
      <h1
        class="font-sans font-bold tracking-tight text-ink"
        style="font-size: clamp(2rem, 5.5vw, 3.75rem); line-height: 1.05;"
      >
        I'm an AI engineer who builds <span class="text-accent">production LLM systems</span> and
        studies <span class="text-accent">why they fail.</span>
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        I take ideas from AI research and make them hold up in production, mostly
        <strong class="font-semibold text-ink">agents</strong> and
        <strong class="font-semibold text-ink">retrieval</strong>. Here I write up what I build and
        test, with the code and data so you can check every number.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] bg-ink px-6 py-3 text-sm font-medium text-paper no-underline transition-transform hover:-translate-y-0.5"
        >
          Read the writing <ArrowRight size={16} stroke-width={2} />
        </a>
        <button
          type="button"
          data-open-subscribe
          class="inline-flex items-center gap-2 text-sm font-medium text-muted transition-colors hover:text-ink"
        >
          <Mail size={17} stroke-width={1.5} /> Get new posts by email
        </button>
        <a
          href={SITE.github}
          target="_blank"
          rel="me noopener"
          class="inline-flex items-center gap-2 text-sm font-medium text-muted no-underline transition-colors hover:text-ink"
        >
          <GithubIcon size={18} stroke-width={1.5} /> GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Trust strip ─────────────────────────────────────────────────── */}
  <TrustStrip />

  {/* ── Writing: one featured + a calm text list ────────────────────── */}
  <section class="mx-auto px-6 py-10" style="max-width: var(--content-max);">
    <div class="flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-widest text-faint">Writing</h2>
      <a href="/blog" class="font-mono text-xs text-muted no-underline hover:text-accent">all →</a>
    </div>

    {
      featured && (
        <div class="mt-5 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
          <FeaturedHero post={featured} />
          <div class="reveal flex flex-col divide-y divide-border">
            {recent.map((post) => (
              <PostListItem post={post} />
            ))}
          </div>
        </div>
      )
    }
    {!featured && <p class="mt-5 py-8 text-faint">No posts yet.</p>}
  </section>

  {/* ── Experiments & benchmarks: research posts, led by their result ── */}
  {
    lab.length > 0 && (
      <section class="mx-auto px-6 py-10" style="max-width: var(--content-max);">
        <div class="flex items-baseline justify-between">
          <h2 class="font-mono text-xs uppercase tracking-widest text-faint">Experiments &amp; benchmarks</h2>
          <a href="/blog?type=experiment" class="font-mono text-xs text-muted no-underline hover:text-accent">
            all →
          </a>
        </div>
        <div class="reveal mt-5 grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));">
          {lab.map((post) => (
            <article class="group relative flex flex-col gap-2.5 rounded-[var(--radius-lg)] border border-border bg-surface p-5 transition-colors hover:border-accent/40">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <TypeTag type={post.data.type} />
                <span class="font-mono text-xs text-faint">
                  {formatDate(post.data.pubDate)} · {readingMinutes(post)} min
                </span>
              </div>
              <h3 class="text-lg font-semibold leading-snug tracking-tight">
                <a
                  href={`/blog/${post.id}`}
                  class="text-ink no-underline transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
                >
                  {post.data.title}
                </a>
              </h3>
              {post.data.result && (
                <p class="border-l-2 border-accent pl-2.5 font-mono text-[0.78rem] leading-snug text-ink">
                  {post.data.result.headline}
                  {post.data.result.detail && <span class="text-muted"> · {post.data.result.detail}</span>}
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    )
  }

  {/* ── Selected work ───────────────────────────────────────────────── */}
  <section class="mx-auto px-6 py-10" style="max-width: var(--content-max);">
    <div class="flex items-baseline justify-between">
      <h2 class="font-mono text-xs uppercase tracking-widest text-faint">Selected work</h2>
      <a href="/projects" class="font-mono text-xs text-muted no-underline hover:text-accent">
        all →
      </a>
    </div>
    <div class="reveal mt-5">
      <BuildInProgress
        title="Case studies in progress"
        message="I'm writing up a few projects properly — outcome, stack, and what I'd do differently. For now, the writing is the clearest window into how I work."
        compact
      />
    </div>
  </section>

  {/* ── Newsletter ──────────────────────────────────────────────────── */}
  <section class="mx-auto px-6 py-10" style="max-width: var(--content-max);">
    <NewsletterBand />
  </section>

  {/* ── About preview ───────────────────────────────────────────────── */}
  <AboutPreview />
</BaseLayout>

<script>
  // Cycle the greeting through a few languages once on load, then settle on
  // English and stay there. No-JS / reduced-motion users just see English (the
  // server-rendered default), so nothing is lost.
  const el = document.querySelector<HTMLElement>("[data-greet]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && !reduce) {
    const greetings = [
      "Hi, I'm Arun", // English
      "வணக்கம், நான் அருண்", // Tamil
      "नमस्ते, मैं अरुण हूँ", // Hindi
      "مرحبًا، أنا أرون", // Arabic
      "ආයුබෝවන්, මම අරුන්", // Sinhalese
      "你好，我是 Arun", // Chinese
      "నమస్కారం, నేను అరుణ్", // Telugu
      "ನಮಸ್ಕಾರ, ನಾನು ಅರುಣ್", // Kannada
      "Bonjour, je suis Arun", // French
      "안녕하세요, 저는 Arun입니다", // Korean
      "Hi, I'm Arun", // English — final, static
    ];

    let i = 0;
    el.style.transition = "opacity 180ms var(--ease, ease)";

    const tick = () => {
      el.style.opacity = "0";
      window.setTimeout(() => {
        el.textContent = greetings[i];
        el.style.opacity = "1";
        i += 1;
        if (i < greetings.length) window.setTimeout(tick, 700);
      }, 180);
    };

    // Start from a blank slate so the first language swap reads as intentional.
    el.style.opacity = "0";
    window.setTimeout(tick, 350);
  }
</script>

<style>
  /* Waving-hand emoji beside the greeting — pivots from the wrist on a gentle
   * loop. Honors prefers-reduced-motion (no animation, hand stays still). */
  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wave {
      animation: wave 2.4s var(--ease, ease) infinite;
    }
    @keyframes wave {
      0%,
      60%,
      100% {
        transform: rotate(0deg);
      }
      10%,
      30% {
        transform: rotate(14deg);
      }
      20% {
        transform: rotate(-8deg);
      }
      40% {
        transform: rotate(-4deg);
      }
      50% {
        transform: rotate(10deg);
      }
    }
  }

  /* Subtle dot-grid texture behind the hero — paint-only, fades toward the
   * lower edge so it never competes with the headline. Theme-aware via --color-ink. */
  .hero-band {
    position: relative;
    isolation: isolate;
    /* The aurora bleeds 15% past each side; clip it horizontally so the page
     * never scrolls sideways, while still letting it glow down into the page. */
    overflow-x: clip;
  }
  .hero-band::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-ink) 9%, transparent) 1px,
      transparent 1.5px
    );
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(125% 100% at 50% 0%, #000 28%, transparent 72%);
    mask-image: radial-gradient(125% 100% at 50% 0%, #000 28%, transparent 72%);
    pointer-events: none;
  }

  /* Soft accent aurora behind the dot-grid — two blurred blobs that drift very
   * slowly so the hero breathes without distracting. Transform/opacity only
   * (GPU-friendly); honors prefers-reduced-motion via the global guard. */
  .hero-band::after {
    content: "";
    position: absolute;
    inset: -25% -15% auto -15%;
    height: 150%;
    z-index: -2;
    background:
      radial-gradient(
        38% 48% at 22% 28%,
        color-mix(in oklab, var(--color-accent) 11%, transparent),
        transparent 70%
      ),
      radial-gradient(
        34% 42% at 82% 18%,
        color-mix(in oklab, var(--color-accent) 7%, transparent),
        transparent 70%
      );
    filter: blur(48px);
    pointer-events: none;
    will-change: transform, opacity;
  }
  :root[data-theme="dark"] .hero-band::after {
    background:
      radial-gradient(
        38% 48% at 22% 28%,
        color-mix(in oklab, var(--color-accent) 16%, transparent),
        transparent 70%
      ),
      radial-gradient(
        34% 42% at 82% 18%,
        color-mix(in oklab, var(--color-accent) 11%, transparent),
        transparent 70%
      );
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-band::after {
      animation: heroAurora 26s var(--ease) infinite alternate;
    }
    @keyframes heroAurora {
      0% {
        transform: translate3d(0, 0, 0) scale(1);
        opacity: 0.85;
      }
      50% {
        transform: translate3d(2.5%, -2%, 0) scale(1.07);
        opacity: 1;
      }
      100% {
        transform: translate3d(-2%, 2%, 0) scale(1.03);
        opacity: 0.8;
      }
    }
  }
</style>
