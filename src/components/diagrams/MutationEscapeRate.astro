---
import Diagram from "../mdx/Diagram.astro";
---

<Diagram
  caption="19 mutants across four surfaces, 4 killed and 15 escaped (79% escape rate). Escapes cluster where the metric was never looking: injected wrong-year context and a skipped auth check both scored identically to the unmutated baseline."
>
  <svg viewBox="0 0 760 260" role="img" aria-label="Grouped bar chart of mutants killed versus escaped across prompt, retrieval, model, and agent surfaces. Prompt: 2 killed, 3 escaped. Retrieval: 1 killed, 5 escaped. Model: 1 killed, 2 escaped. Agent: 0 killed, 5 escaped.">
    <text x="20" y="26" font-family="var(--font-sans)" font-size="13" font-weight="600" fill="var(--color-ink)">Mutants killed vs. escaped, by surface</text>

    <!-- Groups: prompt, retrieval, model, agent. Each group: killed bar + escaped bar -->
    <!-- baseline y=210, scale 26px per mutant -->
    <g font-family="var(--font-mono)" font-size="11" fill="var(--color-muted)">
      <!-- gridline -->
      <line x1="60" y1="210" x2="740" y2="210" stroke="var(--color-border)"></line>

      <!-- prompt: killed 2, escaped 3 -->
      <rect x="80" y={210-52} width="26" height="52" fill="color-mix(in oklab, #2E8B57 78%, var(--color-surface))"></rect>
      <rect x="110" y={210-78} width="26" height="78" fill="var(--color-accent)"></rect>
      <text x="106" y="230" text-anchor="middle" fill="var(--color-ink)">prompt</text>

      <!-- retrieval: killed 1, escaped 5 -->
      <rect x="220" y={210-26} width="26" height="26" fill="color-mix(in oklab, #2E8B57 78%, var(--color-surface))"></rect>
      <rect x="250" y={210-130} width="26" height="130" fill="var(--color-accent)"></rect>
      <text x="246" y="230" text-anchor="middle" fill="var(--color-ink)">retrieval</text>

      <!-- model: killed 1, escaped 2 -->
      <rect x="380" y={210-26} width="26" height="26" fill="color-mix(in oklab, #2E8B57 78%, var(--color-surface))"></rect>
      <rect x="410" y={210-52} width="26" height="52" fill="var(--color-accent)"></rect>
      <text x="406" y="230" text-anchor="middle" fill="var(--color-ink)">model</text>

      <!-- agent: killed 0, escaped 5 -->
      <rect x="540" y={210-4} width="26" height="4" fill="color-mix(in oklab, #2E8B57 78%, var(--color-surface))"></rect>
      <rect x="570" y={210-130} width="26" height="130" fill="var(--color-accent)"></rect>
      <text x="566" y="230" text-anchor="middle" fill="var(--color-ink)">agent</text>
    </g>

    <!-- CRITICAL callouts -->
    <text x="263" y={210-134} font-family="var(--font-mono)" font-size="10" font-weight="700" fill="#C2402F" text-anchor="middle">wrong-year ✗</text>
    <text x="583" y={210-134} font-family="var(--font-mono)" font-size="10" font-weight="700" fill="#C2402F" text-anchor="middle">skip-auth ✗</text>

    <!-- Legend -->
    <g font-family="var(--font-mono)" font-size="11">
      <rect x="500" y="20" width="12" height="12" rx="2" fill="color-mix(in oklab, #2E8B57 78%, var(--color-surface))"></rect>
      <text x="518" y="30" fill="var(--color-muted)">killed</text>

      <rect x="600" y="20" width="12" height="12" rx="2" fill="var(--color-accent)"></rect>
      <text x="618" y="30" fill="var(--color-muted)">escaped</text>
    </g>
  </svg>
</Diagram>
