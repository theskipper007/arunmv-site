---
import PageLayout from "../../layouts/PageLayout.astro";
import NewsletterBand from "../../components/newsletter/NewsletterBand.astro";
import sent from "../../data/newsletter-sent.json";

// Written by scripts/newsletter-send.mjs after each broadcast.
const issues = [...(sent as { slug: string; title: string; date: string }[])].reverse();
---

<PageLayout
  title="Newsletter"
  description="New posts from Arun MV by email: experiments, explainers and build logs on retrieval, LLM evaluation and agent reliability."
>
  <div style="max-width: var(--prose-width);">
    <p class="font-mono text-xs uppercase tracking-widest text-faint">Newsletter</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-ink sm:text-4xl">New posts, by email</h1>
    <p class="mt-3 text-lg text-muted">
      One email when something new goes up: experiments, explainers and build logs, with the
      headline result in the subject line. Pick technical posts only, or everything including the
      personal stream.
    </p>

    <p class="nl-error mt-6 hidden rounded-[var(--radius-md)] border border-border p-3 text-sm" data-error></p>

    <div class="mt-8">
      <NewsletterBand stacked />
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-faint">Confirm</p>
        <p class="mt-1.5 text-sm text-muted">
          You get one email with a confirm link. Nothing is sent until you click it.
        </p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-faint">Frequency</p>
        <p class="mt-1.5 text-sm text-muted">Only when a post is published.</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-faint">Leave</p>
        <p class="mt-1.5 text-sm text-muted">Every email has a one-click unsubscribe link.</p>
      </div>
    </div>

    <h2 class="mt-12 text-xl font-semibold tracking-tight text-ink">Past issues</h2>
    {
      issues.length ? (
        <ul class="mt-3 divide-y divide-border">
          {issues.map((i) => (
            <li class="flex items-baseline justify-between gap-4 py-2.5">
              <a href={`/blog/${i.slug}`} class="text-ink no-underline hover:text-accent">
                {i.title}
              </a>
              <span class="shrink-0 font-mono text-xs text-faint">{i.date}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-2 text-sm text-muted">No issues sent yet.</p>
      )
    }

    <p class="mt-10 text-sm text-muted">
      Prefer a feed? <a href="/rss-technical.xml">Technical RSS</a> · <a href="/rss.xml">Everything RSS</a>
    </p>
  </div>
</PageLayout>

<script>
  // No-JS form posts land here with ?error=; explain what went wrong.
  function showError() {
    const el = document.querySelector<HTMLElement>("[data-error]");
    const code = new URL(location.href).searchParams.get("error");
    if (!el || !code) return;
    const messages: Record<string, string> = {
      email: "That doesn't look like an email address. Check it and try again.",
      send: "Couldn't send the confirmation email. Try again in a minute.",
      form: "Something went wrong with the form. Try again.",
    };
    el.textContent = messages[code] ?? messages.form;
    el.classList.remove("hidden");
  }
  showError();
  document.addEventListener("astro:page-load", showError);
</script>
